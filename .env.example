# Copy this file to ".env" and paste YOUR key (never share it or commit it)
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
# The model can be chosen inside the website (Settings). These are only optional defaults:
#GEMINI_MODEL=gemini-flash-lite-latest
# Optional: force seconds between requests (otherwise automatic: 4s for lite models, 12s for others)
#GEMINI_MIN_GAP=6
EXAM_SIZE=10
